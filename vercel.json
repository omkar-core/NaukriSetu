{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend/api/index.js" },
    { "source": "/(.*)", "destination": "frontend/dist/$1" }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install"
}
