{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/cron.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/api/cron", "dest": "api/cron.js" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 */3 * * *"
    }
  ]
}
