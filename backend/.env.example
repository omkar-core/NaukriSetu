# ============================================================
# NaukriSetu Backend Environment Variables - EXAMPLE FILE
# Copy this to .env and fill in your actual keys
# NEVER commit the actual .env file to version control
# ============================================================

# News Data Sources
NEWS_API_KEY=YOUR_NEWSAPI_KEY_HERE
GNEWS_API_KEY=YOUR_GNEWS_KEY_HERE

# Job Data APIs
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE
JSEARCH_HOST=jsearch.p.rapidapi.com
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE

# AI Processing
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# Email Service (Resend)
EMAIL_API_KEY=YOUR_RESEND_KEY_HERE
EMAIL_FROM=onboarding@resend.dev
EMAIL_ADMIN=your@email.com

# Optional: Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_ID=YOUR_CHANNEL_ID

# Security
CRON_SECRET=generate_a_random_string_here
ADMIN_JWT_SECRET=generate_another_random_string_here

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
